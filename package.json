{
  "name": "my-nuxt-stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "exports": {
    "./trpc": "./server/trpc/routers/_app.ts"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently -k -n nuxt,trigger -c cyan,magenta \"nuxt dev\" \"pnpm trigger:dev\"",
    "trigger:dev": "prisma generate --schema prisma/schema && trigger dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate --schema prisma/schema",
    "setup:https": "node scripts/setup-https.mjs",
    "type-check": "nuxt typecheck",
    "clean": "rm -rf node_modules .nuxt .output .turbo",
    "db:generate": "prisma generate --schema prisma/schema",
    "db:migrate": "prisma migrate dev --schema prisma/schema",
    "db:reset": "prisma migrate reset --schema prisma/schema --skip-seed",
    "db:push": "prisma db push --schema prisma/schema",
    "db:studio": "prisma studio --schema prisma/schema"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@iconify-json/fluent": "^1.2.55",
    "@iconify-json/hugeicons": "^1.2.32",
    "@iconify-json/jam": "^1.2.3",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/vue": "^5.0.0",
    "@pinia/nuxt": "^1.0.1",
    "@prisma/client": "^6.0.0",
    "@tanstack/vue-query": "^5.101.2",
    "@trigger.dev/sdk": "^4.1.0",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "better-auth": "^1.2.8",
    "js-cookie": "^3.0.5",
    "nuxt": "^4.4.8",
    "pinia": "^4.0.2",
    "resend": "^4.5.1",
    "superjson": "^2.2.2",
    "tailwindcss": "^4.3.1",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0",
    "vuetify": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.20.1",
    "concurrently": "^9.1.2",
    "prisma": "^6.0.0",
    "trigger.dev": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
