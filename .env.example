# Tier 1 — required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_nuxt_stack
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME=my-nuxt-stack

# Tier 2 — optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=my-nuxt-stack <onboarding@resend.dev>

# Trigger.dev (optional — required for background jobs)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=proj_SET_TRIGGER_PROJECT_REF
